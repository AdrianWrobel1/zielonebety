# Environment Configuration Example Template
# Copy to .env and set actual production secrets

ENVIRONMENT=production
LOG_LEVEL=INFO

# PostgreSQL Database Settings
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=zielonebety
POSTGRES_USER=zielonebety_user
POSTGRES_PASSWORD=CHANGE_THIS_IN_PRODUCTION_SECRET_KEY

# Redis Settings
REDIS_HOST=redis
REDIS_PORT=6379

# Authentication & Security
JWT_SECRET_KEY=CHANGE_THIS_SUPER_SECRET_JWT_KEY_32_BYTES_MIN
JWT_ALGORITHM=HS256
TOKEN_EXPIRE_MINUTES=1440

# Control-plane admin auth (P1-007): single local administrator.
# Production MUST set ADMIN_PASSWORD to a strong secret. When unset outside
# production, a documented dev-only fallback applies; production without
# ADMIN_PASSWORD refuses all logins (fail-closed).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD_IN_PRODUCTION

# Explicit browser origins allowed credentialed CORS (comma-separated).
# Same-origin deployments (nginx) need no entry here. "*" is never honored.
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Notifications Settings
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyZ
TELEGRAM_CHAT_ID=-1001234567890
TELEGRAM_LIVE_TEST=true

# Scanner Engine Parameters
MIN_SUREBET_ROI=1.5
MIN_VALUEBET_EV=3.0
RATE_LIMIT_PER_MINUTE=120

# StatsHub Player Props Provider
STATSHUB_ENABLED=true

